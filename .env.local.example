# ============================================================
# 只有猫 · Supabase 环境变量配置
# 用法：复制本文件为 .env.local，并填入你的真实密钥
# 获取位置：Supabase 控制台 → 你的项目 → Settings → API
#           （数据库连接串在 Settings → Database → Connection string）
# ============================================================

# ---------- 1) API 配置（前端 + 服务端通用，必须） ----------
# 项目 URL，形如 https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# publishable 公钥（新版命名，旧称 anon public key，形如 sb_publishable_xxx），可安全暴露给浏览器
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# ---------- 2) 服务端专用（必须） ----------
# secret 密钥（新版命名，旧称 service_role secret key，形如 sb_secret_xxx），切勿暴露到客户端
# 仅用于后台用户管理读取邮箱等特权操作
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# ---------- 3) 数据库直连（端口 5432，可选，用于 psql/迁移脚本） ----------
# 格式：postgresql://postgres.<项目ref>:<数据库密码>@db.<项目ref>.supabase.co:5432/postgres
# 项目 ref = URL 中 xxxxxxxx 部分；数据库密码在创建项目时设置，可在 Database 页重置
SUPABASE_DB_URL=postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# ---------- 4) 数据库连接池（Supavisor，端口 6543，可选，推荐服务端使用） ----------
# 事务连接池：postgresql://postgres.<ref>.<region>:<密码>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 直连连接池：postgresql://postgres.<ref>:<密码>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 推荐使用「事务连接池」（密码前的 .pooler 后缀），适合服务端短连接
SUPABASE_DB_POOLER_URL=postgresql://postgres.YOUR_REF.pooler.YOUR_REGION:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# ---------- 5) 项目引用号（可选，用于 Supabase CLI / 迁移） ----------
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# ---------- 6) 管理后台独立登录（必须，请修改为强密码） ----------
# 与站点用户体系解耦，访问 /admin 需用此账号登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设置强密码

# ---------- 7) AI 自动审核（apiyi，必须） ----------
# 图片生成模型（种子内容脚本用）
AI_IMAGE_MODEL=gpt-image-2
# 视觉审核模型（自动审核用，需支持视觉输入）
AI_VISION_MODEL=gpt-5.5

# ---------- 8) apiyi API（图片生成 + AI 审核共用） ----------
APIYI_BASE_URL=https://api.apiyi.com/v1
APIYI_API_KEY=YOUR_APIYI_KEY

# ---------- 9) deepseek（界面多语言词典翻译生成 / P2 内容自动翻译） ----------
# 仅开发期生成词典与后续内容翻译使用；词典文件已提交到仓库，生产运行不需要
DEEPSEEK_V4_BASE_URL=https://api.deepseek.com
DEEPSEEK_V4_FLASH_API_KEY=YOUR_DEEPSEEK_KEY
DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash

